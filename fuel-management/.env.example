# Copiar a .env.local y completar con los datos del proyecto Supabase (Project Settings → API).
# Solo la URL y la clave pública "anon": la clave service_role NUNCA va en el frontend.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Mostrar "Ingresar con Microsoft" cuando TI haya registrado la aplicación en Entra ID
# y se haya habilitado el proveedor Azure en Supabase (Authentication → Providers).
VITE_AUTH_MICROSOFT=false
