# Servicio systemd para Linux. Copiar a /etc/systemd/system/ y ajustar rutas/usuario.
[Unit]
Description=Pedidos de Combustible CT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=combustible
WorkingDirectory=/opt/combustible-ct
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/combustible-ct/data

[Install]
WantedBy=multi-user.target
