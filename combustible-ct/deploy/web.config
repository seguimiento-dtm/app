<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS como proxy HTTPS hacia la app (requiere los módulos URL Rewrite y Application Request Routing con el proxy habilitado). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="CombustibleCT" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
