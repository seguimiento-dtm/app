# Copiar a .env (no versionado) y completar en el SERVIDOR. Nunca subir .env al repositorio.
PORT=3000
# 127.0.0.1 si hay un proxy (IIS/Nginx) en el mismo servidor; 0.0.0.0 para acceso directo
HOST=0.0.0.0
# Zona horaria operativa para fechas y horas
APP_TZ=America/Argentina/Buenos_Aires
# Ruta del archivo de base de datos SQLite (persistente)
DB_FILE=./data/combustible-ct.db
# true si la app se sirve por HTTPS (recomendado en producción)
COOKIE_SECURE=false

# ---- Correo: elegir UNO de los dos proveedores ----
MAIL_PROVIDER=smtp

# Opción A: SMTP corporativo (Microsoft 365: smtp.office365.com, puerto 587, SMTP_SECURE=false -> STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente, p. ej. "Pedidos Combustible CT <pedidos.combustible@pan-energy.com>"
MAIL_FROM=

# Opción B: Microsoft Graph (MAIL_PROVIDER=graph). App registrada en Entra ID con permiso de aplicación Mail.Send.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Buzón remitente (UPN), p. ej. pedidos.combustible@pan-energy.com
GRAPH_SENDER=

# Solo para relays internos sin TLS (no recomendado). Por defecto se exige STARTTLS.
# SMTP_REQUIRE_TLS=false
